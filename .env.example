# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会提交）

# 问答模型：任意 OpenAI 兼容端点（示例为 AMD Radeon 开发者端点）
DASHSCOPE_API_KEY=your_chat_api_key_here
QWEN_MODEL=Qwen3.8-27B
QWEN_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# 向量模型：DashScope 官方端点（embedding 与问答可用不同账户）
EMBEDDING_API_KEY=your_dashscope_api_key_here
# EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# 联网搜索（可选，不填则禁用）
# TAVILY_API_KEY=your_tavily_api_key_here
